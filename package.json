{
  "name": "deslop-search",
  "version": "1.1.0",
  "description": "Clean web search utility, Split-Horizon comparative engine, CLI, TypeScript/Python SDK, and AI Agent Skill that rescues pre-slop human technical results via temporal dorks (before:2023), community source routing, and heuristic AI slop classification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-tools.d.ts",
      "import": "./dist/mcp-tools.js"
    }
  },
  "bin": {
    "deslop": "./dist/cli.js",
    "deslop-search": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "SKILL.md",
    "skill.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python -m unittest discover -s tests/py -p \"test_*.py\" -v",
    "verify": "npm run typecheck && npm run build && npm run test && npm run test:py",
    "deslop": "node ./dist/cli.js"
  },
  "keywords": [
    "search",
    "dorks",
    "before-2023",
    "dead-internet",
    "anti-slop",
    "seo-filter",
    "ai-agent-skill",
    "mcp",
    "developer-tools",
    "cli",
    "human-web"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
